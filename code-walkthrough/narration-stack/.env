# Port for the Narration Studio web interface
STUDIO_PORT=8090

# Port Chatterbox is published on (for tools/narrate.py on other machines)
CHATTERBOX_PORT=4123

# Absolute path on the homelab to the folder with your lessons (optional).
# Leave as is if you only use the studio for free text.
LESSONS_PATH=./lessons

# Chatterbox defaults, used when a request does not set them
CHATTERBOX_EXAGGERATION=0.4
CHATTERBOX_CFG_WEIGHT=0.5
CHATTERBOX_TEMPERATURE=0.7

# Optional: push the studio image to your own registry, for example
STUDIO_IMAGE=192.168.50.203:7000/narration-studio:latest
